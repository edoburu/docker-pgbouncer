# Every variable the entrypoint reads, each with a distinct value, so dropping or
# renaming one shows up as a diff. Not booted: the TLS paths do not exist.
DB_HOST=db.example.com
DB_PORT=6543
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=s3cret
CLIENT_ENCODING=UTF8
LISTEN_ADDR=*
LISTEN_PORT=6432
UNIX_SOCKET_DIR=/var/run/pgbouncer
AUTH_HBA_FILE=/etc/pgbouncer/pg_hba.conf
AUTH_TYPE=scram-sha-256
AUTH_USER=authuser
AUTH_QUERY=SELECT usename, passwd FROM pg_shadow WHERE usename=$1
AUTH_DBNAME=authdb
POOL_MODE=transaction
MAX_CLIENT_CONN=2000
POOL_SIZE=30
DEFAULT_POOL_SIZE=64
MIN_POOL_SIZE=5
RESERVE_POOL_SIZE=10
RESERVE_POOL_TIMEOUT=3
MAX_DB_CONNECTIONS=90
MAX_USER_CONNECTIONS=80
SERVER_ROUND_ROBIN=1
IGNORE_STARTUP_PARAMETERS=extra_float_digits,search_path
DISABLE_PQEXEC=0
APPLICATION_NAME_ADD_HOST=1
TIMEZONE=UTC
MAX_PREPARED_STATEMENTS=200
LOG_CONNECTIONS=1
LOG_DISCONNECTIONS=1
LOG_POOLER_ERRORS=1
LOG_STATS=1
STATS_PERIOD=60
VERBOSE=1
ADMIN_USERS=postgres,adminuser
STATS_USERS=statsuser
LOGFILE=/var/log/pgbouncer/pgbouncer.log
SERVER_RESET_QUERY=DISCARD ALL
SERVER_RESET_QUERY_ALWAYS=0
SERVER_CHECK_DELAY=30
SERVER_CHECK_QUERY=select 1
SERVER_LIFETIME=3600
SERVER_IDLE_TIMEOUT=600
SERVER_CONNECT_TIMEOUT=15
SERVER_LOGIN_RETRY=15
CLIENT_LOGIN_TIMEOUT=60
AUTODB_IDLE_TIMEOUT=3600
DNS_MAX_TTL=15
DNS_NXDOMAIN_TTL=15
CLIENT_TLS_SSLMODE=require
CLIENT_TLS_KEY_FILE=/etc/pgbouncer/tls/client.key
CLIENT_TLS_CERT_FILE=/etc/pgbouncer/tls/client.crt
CLIENT_TLS_CA_FILE=/etc/pgbouncer/tls/client-ca.crt
CLIENT_TLS_PROTOCOLS=secure
CLIENT_TLS_CIPHERS=HIGH:!aNULL
CLIENT_TLS_ECDHCURVE=prime256v1
CLIENT_TLS_DHEPARAMS=auto
SERVER_TLS_SSLMODE=verify-full
SERVER_TLS_CA_FILE=/etc/pgbouncer/tls/server-ca.crt
SERVER_TLS_KEY_FILE=/etc/pgbouncer/tls/server.key
SERVER_TLS_CERT_FILE=/etc/pgbouncer/tls/server.crt
SERVER_TLS_PROTOCOLS=secure
SERVER_TLS_CIPHERS=HIGH:!aNULL
QUERY_TIMEOUT=120
QUERY_WAIT_TIMEOUT=120
CLIENT_IDLE_TIMEOUT=0
IDLE_TRANSACTION_TIMEOUT=0
PKT_BUF=4096
MAX_PACKET_SIZE=2147483647
LISTEN_BACKLOG=128
SBUF_LOOPCNT=5
SUSPEND_TIMEOUT=10
TCP_DEFER_ACCEPT=1
TCP_KEEPALIVE=1
TCP_KEEPCNT=9
TCP_KEEPIDLE=7200
TCP_KEEPINTVL=75
TCP_USER_TIMEOUT=0
